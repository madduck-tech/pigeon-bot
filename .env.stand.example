# Local test stand: copy to .env.stand (git-ignored) and fill in your own values.
# How to get each one: docs/operations.md, «Тестовый стенд». Never commit .env.stand.

# Token of YOUR test bot from @BotFather. Never the production bot: the stand refuses it.
PIGEON_STAND_TOKEN=123456789:replace-with-the-test-bot-token

# The test group. Supergroup ids start with -100.
PIGEON_STAND_CHAT_ID=-1001234567890

# user_id of a group admin: your own account (the group creator works).
PIGEON_STAND_ADMIN_ID=111111111

# user_id of a plain member: a second bot added to the group WITHOUT admin rights.
PIGEON_STAND_MEMBER_ID=222222222

# Optional: where run folders (report.json, report.public.json, stand.db) go.
# PIGEON_STAND_RUNS_DIR=stand-runs
